{
  "name": "dre-video-avatar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "register:secret": "node scripts/register-elevenlabs-secret.mjs",
    "footprints:tail": "node --env-file=.env scripts/tail-footprints.mjs",
    "footprints:check": "node --env-file=.env scripts/check-footprints.mjs",
    "embed:key": "node --env-file=.env scripts/add-embed-key.mjs",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "footprints:prune": "node --env-file=.env scripts/prune-footprints.mjs",
    "embed:keys": "node --env-file=.env scripts/list-embed-keys.mjs",
    "sandbox": "node --env-file=.env scripts/make-sandbox-page.mjs"
  },
  "dependencies": {
    "@elatre/liveavatar-web-sdk": "link:./node_modules/@elatre",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

# ---- Server-only. Never prefix these with NEXT_PUBLIC_. ----

LIVEAVATAR_API_KEY=

# Run `pnpm register:secret` once to exchange your ElevenLabs key for this id.
LIVEAVATAR_ELEVENLABS_SECRET_ID=

# The ElevenLabs agent that drives the conversation.
# Its TTS output format AND user input audio format must both be PCM 24000 Hz.
ELEVENLABS_AGENT_ID=

# Optional overrides
LIVEAVATAR_API_URL=https://api.liveavatar.com
LIVEAVATAR_DEFAULT_AVATAR_ID=

# ---- Only needed while running scripts/register-elevenlabs-secret.mjs ----
# Must be a PAID-plan key with scopes: convai_read, user_read, voices_read
ELEVENLABS_API_KEY=

# ---- Client-visible (safe: an avatar id is not a secret) ----
NEXT_PUBLIC_AVATAR_ID=

# ---- Database ----

# Everything the service stores — embed keys and session footprints — lives
# here. Quote it: a URL with query parameters contains `&`, which breaks a
# shell that sources this file.
#
# Local, from docker-compose.yml — `pnpm db:up`:
DATABASE_URL="postgresql://avatar:avatar@localhost:5441/dre_video_avatar?schema=public"
#
# A managed server such as RDS. `verify-full` checks the certificate chain and
# the hostname; the CA bundle is committed at certs/. Without it the
# connection fails with "self-signed certificate in certificate chain", and
# `sslmode=no-verify` encrypts without checking who is on the other end.
# DATABASE_URL="postgresql://user:password@host:5432/db?schema=public&sslmode=verify-full&sslrootcert=./certs/rds-global-bundle.pem"

# Overrides the URL for Prisma's own CLI (studio, migrate) without touching
# the application's. Needed because Studio cannot complete TLS to RDS with a
# custom CA — see docs/footprints.md.
# PRISMA_DATABASE_URL=

# No call holds a concurrency slot longer than this, however recently it
# reported in. Defaults to 60. Lower it only below your vendor's maximum
# session duration, or a real long call will lose its line mid-conversation.
# SESSION_MAX_AGE_MINUTES=60

# End-to-end tests create and wipe a database, so they never use DATABASE_URL.
# They default to the local Postgres; set this only to point them elsewhere.
# E2E_DATABASE_URL=

# ---- Embedding (iframe-as-a-service) ----

# Signs the short-lived embed grant that /embed/<key> hands the browser.
# REQUIRED in production. 32+ characters: `openssl rand -hex 32`
EMBED_GRANT_SECRET=


# ---- Session footprints ----

# Set to false to record nothing at all.
FOOTPRINTS_ENABLED=true

# Enforced by the service itself as events arrive. There is no cron job.
FOOTPRINTS_RETENTION_DAYS=90

# Set to false to keep lifecycle events but record no transcript text.
FOOTPRINT_TRANSCRIPTS=true

# Salts the hashed visitor IP. An unsalted hash of an IPv4 address is an IPv4
# address to anyone with an afternoon. Rotating it breaks correlation, by design.
#   openssl rand -hex 16
IP_HASH_SALT=

# Check all of the above, and that retention is actually being enforced:
#   pnpm footprints:check
